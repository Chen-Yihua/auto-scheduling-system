{
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh label list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *Merge*)"
    ]
  }
}
