CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
MONGO_URI=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 用來加密/解密第三方帳密（GitHub apiKey、Jira apiKey、Moodle password）
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# CORS 允許的前端網域，逗號分隔。不設定時預設只放行 http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# GitHub PR webhook 用的 Discord 通知網址，不設定就直接跳過發送
DISCORD_MR_WEBHOOK_URL=
DISCORD_MAIN_WEBHOOK_URL=

# GitHub repo 的 Settings > Webhooks 設定裡填的 Secret，要跟這裡設定的值一致，
# 否則 /webhook 一律回 401——防止任何人拿到網址就能觸發 Gemini 呼叫
GITHUB_WEBHOOK_SECRET=

# 專門給 MR 摘要機器人用的 GitHub token（讀 PR 變更檔案、貼留言），
# 跟使用者自己連結 GitHub 帳號用的 apiKey 是不同東西，需要 repo 的讀寫權限
GITHUB_BOT_TOKEN=

# 流量限制（rate_limit.py）用的儲存後端。不設定就用記憶體（單一 instance 才準確，
# 本機開發/尚未接 Redis 時用這個就好）；設定後自動改用 Redis，格式例如
# redis://default:password@host:6379 或 Upstash 這類服務給的連線字串
REDIS_URL=
