{
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh label list *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Bash(*--force*)",
      "Bash(* -f *)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *Merge*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ]
  }
}
