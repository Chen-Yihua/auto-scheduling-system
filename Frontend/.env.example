# 複製成 Frontend/.env 並填值（.env 不會被 git 追蹤）

# 【必填】Clerk（登入）。到 Clerk Dashboard → API Keys 複製，
# 兩把金鑰要來自同一個 Clerk 專案，而且要跟後端的 CLERK_ISSUER / CLERK_JWKS_URL 是同一個專案。
# 開發用 pk_test_ / sk_test_，不要用正式環境（pk_live_ / sk_live_）的金鑰
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# 後端 API 網址。不設定時預設 http://localhost:8000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 這個前端自己的網址（Google Calendar 授權完成後導回用）。不設定時預設 http://localhost:3000
NUXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Google Calendar 授權用的 OAuth Client ID（跟後端的 GOOGLE_CLIENT_ID 是同一個）。
# 不設定的話，「連接 Google Calendar」會無法使用
GOOGLE_CLIENT_ID=

# --- 只有要在本機跑登入後的 E2E 測試才需要（見 README「測試」）---
# 這個使用者必須存在於上面那組金鑰所屬的 Clerk 專案裡
# E2E_CLERK_TEST_EMAIL=
